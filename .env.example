# 复制到.env前先保留已有配置；不要覆盖真实密钥。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 新链路独立集合；旧COLLECTION_NAME仅供历史数据维护。
HYBRID_COLLECTION_NAME=finance_pdf_chunks_v3
COLLECTION_NAME=finance_pdf_chunks
CHROMA_DIR=data/chroma_db
INDEX_REGISTRY_PATH=data/index_registry.sqlite3
PDF_DIR=data/source
DOCUMENT_DIR=data/documents
PARSE_LOG_DIR=data/parse_log
PARSE_JOBS_DIR=data/parse_jobs
PARSE_LOG_ENABLED=true
ENABLE_INDEXING=false

# MinerU由此解释器在独立进程运行；代码固定standard、本地ONNX和llama-cpp。
MINERU_ENABLED=true
MINERU_PYTHON=E:\learn_space\mineru\env\.venv\Scripts\python.exe
MINERU_MODEL_BASE_DIR=E:\learn_space\mineru\model
MINERU_CACHE_DIR=data/parser_cache/mineru
MINERU_TIMEOUT_SECONDS=1800

# PyMuPDF普通文字与版面预检；普通扫描文字才使用Tesseract。
LAYOUT_ENABLED=true
HEADER_REMOVE=true
FOOTER_REMOVE=false
# 唯一清洗阶段：混合解析/OCR完成后、正文和跨页组装前；只在顶部候选区匹配广告。
HEADER_FILTER_TOP_RATIO=0.12
HEADER_REPEAT_MIN_PAGES=3
HEADER_REPEAT_MIN_RATIO=0.6
HEADER_REPEAT_POSITION_TOLERANCE=0.02
# JSON正则数组，完整匹配广告行；实际运行读取.env，此模板不生效。
HEADER_AD_PATTERNS=[]
TABLE_STRATEGY=lines_strict
ENABLE_OCR=true
TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
OCR_LANG=chi_sim+eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=120
ROUTING_COMPLEX_AREA_RATIO=0.35
MAX_INVALID_CHAR_RATIO=0.01
PARSE_LOG_INCLUDE_ELEMENTS=true
PARSE_LOG_ELEMENT_TEXT_MAX=200

# 使用本地目录或已缓存模型；缺少模型时默认报错，不自动下载。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_ONLY=true
EMBEDDING_REVISION=
EMBEDDING_MAX_TOKENS=512
CHUNK_SIZE=700
CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=9000

# 页面日志在控制台显示，同时保存运行事件和每次解析的events.jsonl。
LOG_DIR=data/logs
LOG_LEVEL=INFO
LOG_TO_FILE=true

# standard、MinerU并发1、schema v3和人工审阅门禁是当前固定约束，不能用.env绕过。
