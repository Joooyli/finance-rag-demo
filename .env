# 兼容 OpenAI Chat Completions API 的服务商地址，通常以 /v1 结尾
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol

# 本地 embedding 模型。首次启动需要下载模型；之后可离线使用缓存。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 项目内相对路径
PDF_DIR=data/source
CHROMA_DIR=data/chroma_db
COLLECTION_NAME=finance_pdf_chunks

# 切块参数：按字符数切块，适合第一版教学；后续可改成按 token/标题切块
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=9000

# OCR：需另外安装 Tesseract，并安装 chi_sim + eng 语言包
ENABLE_OCR=true
OCR_LANG=chi_sim+eng
# Windows 示例：取消注释并按实际安装位置修改
TESSERACT_CMD=D:\software_down\tesseract\tesseract.exe

# 是否在 PDF 页面没有足够可提取文字时，对整页做 OCR
OCR_LOW_TEXT_PAGES=true
MIN_NATIVE_TEXT_CHARS=80

# 解析与入库分两步：默认只解析、写日志，不入库。
# 检查 data/parse_log 或 http://127.0.0.1:8000/ui 后，再改为 true 重新执行。
ENABLE_INDEXING=false
INDEX_BATCH_SIZE=32

# 中间解析产物：pages.jsonl（每页一行）、chunks.jsonl（每个切块一行）
PARSE_LOG_ENABLED=true
PARSE_LOG_DIR=data/parse_log

# 运行日志（控制台 + data/logs/app.log）
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=data/logs

